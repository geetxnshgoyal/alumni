# Copy this file to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection strings (postgresql://USER:PASSWORD@HOST:PORT/DBNAME)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/alumni_db
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/alumni_test
# Set to true for hosted databases that require SSL (Neon, Supabase, external Render URL)
DATABASE_SSL=false

# JWT signing secret - use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins for CORS (leave empty to allow same-origin only)
CORS_ORIGIN=

# Used by `npm run seed` to create the first admin account
SEED_ADMIN_EMAIL=admin@alumni.test
SEED_ADMIN_PASSWORD=Admin@12345
